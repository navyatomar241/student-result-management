# Supabase Project Credentials
# Obtain these from your Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase PostgreSQL Direct Connection URL
# Obtain from Project Dashboard -> Settings -> Database -> Connection String (URI / Session mode or Transaction mode)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
# Format with pooler: postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# Supabase JWT Issuer (Used by C++ backend to verify token claims)
SUPABASE_JWT_ISSUER=https://your-project-id.supabase.co/auth/v1

# C++ Crow Backend Server Port
PORT=18080
